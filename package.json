{
  "name": "navpdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, local PDF workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": ".venv/bin/python -m pytest tests -q",
    "setup": "python3 scripts/setup.py",
    "package": "npm run build && electron-builder --dir",
    "test:integration": "node --test tests/transport.test.cjs",
    "format": "prettier --write src electron vite.config.ts eslint.config.js"
  },
  "build": {
    "appId": "local.navpdf.editor",
    "productName": "NavPDF",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": ".venv",
        "to": "python"
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
