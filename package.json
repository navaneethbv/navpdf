{
  "name": "navpdf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A private, local PDF workspace",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host localhost --port 1420",
    "desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src scripts tests/unit tests/integration vite.config.ts eslint.config.js",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:integration": "vitest run tests/integration",
    "pretest:integration": "npm run fixtures",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "npm run fixtures",
    "fixtures": "node scripts/create-fixtures.mjs",
    "package": "tauri build",
    "format": "prettier --write src scripts tests/unit tests/integration vite.config.ts eslint.config.js",
    "format:check": "prettier --check src scripts tests/unit tests/integration vite.config.ts eslint.config.js",
    "pretest": "npm run fixtures"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-streams-polyfill": "^4.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
