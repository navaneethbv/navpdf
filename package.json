{
  "name": "navpdf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A private, local PDF workspace",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host localhost --port 1420",
    "desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "node --require ./scripts/eslint-compat.cjs ./node_modules/eslint/bin/eslint.js src scripts tests/unit tests/integration vite.config.ts eslint.config.js",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:integration": "vitest run tests/integration",
    "pretest:integration": "npm run fixtures",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "npm run fixtures",
    "fixtures": "node scripts/create-fixtures.mjs",
    "acceptance:phase7": "node scripts/phase7-acceptance.mjs",
    "acceptance:phase8": "node scripts/phase8-acceptance.mjs",
    "acceptance:phase10": "node scripts/phase10-acceptance.mjs",
    "acceptance:ocr": "node scripts/ocr-native-acceptance.mjs",
    "acceptance:licenses": "node scripts/license-inventory.mjs",
    "acceptance:check-tools": "node scripts/check-tools.mjs",
    "perf:fixture": "node scripts/make-heavy-fixture.mjs",
    "perf:probe": "node scripts/memory-probe.mjs",
    "perf:drive": "sh scripts/memory-drive.sh",
    "package": "tauri build",
    "format": "prettier --write src scripts tests/unit tests/integration vite.config.ts eslint.config.js",
    "format:check": "prettier --check src scripts tests/unit tests/integration vite.config.ts eslint.config.js",
    "pretest": "npm run fixtures"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-streams-polyfill": "^4.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@typescript/typescript6": "^6.0.2"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "npm:@typescript/typescript6@latest"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "npm:@typescript/typescript6@latest"
    },
    "@typescript-eslint/parser": {
      "typescript": "npm:@typescript/typescript6@latest"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "npm:@typescript/typescript6@latest"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "npm:@typescript/typescript6@latest"
    },
    "@typescript-eslint/utils": {
      "typescript": "npm:@typescript/typescript6@latest"
    },
    "ts-api-utils": {
      "typescript": "npm:@typescript/typescript6@latest"
    }
  }
}
